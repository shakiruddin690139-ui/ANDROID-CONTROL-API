rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.userId is string && data.userId == request.auth.uid
        && data.email is string
        && (!('displayName' in data) || data.displayName is string)
        && (!('photoUrl' in data) || data.photoUrl is string);
    }

    function isValidProject(data, userId) {
      return data.id is string
        && data.userId == userId
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && (!('description' in data) || data.description is string)
        && data.platform is string
        && (!('status' in data) || data.status is string)
        && (!('filesJson' in data) || data.filesJson is string);
    }

    function isValidConversation(data, userId) {
      return data.id is string
        && data.userId == userId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && (!('providerId' in data) || data.providerId is string)
        && (!('modelId' in data) || data.modelId is string)
        && (!('lastMessage' in data) || data.lastMessage is string);
    }

    function isValidMessage(data, userId, conversationId) {
      return data.id is string
        && data.conversationId == conversationId
        && data.userId == userId
        && data.role in ['user', 'model', 'system']
        && data.content is string;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) && (request.method != 'create' && request.method != 'update' || isValidUser(request.resource.data));

      match /projects/{projectId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidProject(request.resource.data, userId);
      }

      match /conversations/{conversationId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidConversation(request.resource.data, userId);

        match /messages/{messageId} {
          allow read, delete: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidMessage(request.resource.data, userId, conversationId);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
